# SecretSentinel configuration template. Names only - NEVER commit real values.
# Copy to .env and start the dashboard with:  secretsentinel serve --env-file .env
# (SecretSentinel never auto-loads .env files, so a scanned repository cannot configure the scanner.)

APP_ENV=development
HOST=127.0.0.1
PORT=8000
# Default when unset: ~/.secretsentinel/secretsentinel.db (outside any repository)
DB_URL=sqlite:///./data/secretsentinel.db
GITLEAKS_PATH=gitleaks
SCANNER_TIMEOUT_SECONDS=120
MAX_SCAN_FILE_MB=10
MAX_REPO_MB=2048
# Folders the dashboard may scan. Separate several with ';' (Windows) or ':' (Linux/macOS).
SCAN_ROOT_ALLOWLIST=./sample-repos
FAIL_ON=high
LOG_LEVEL=INFO
MAX_CONCURRENT_SCANS=1
# Delete scans older than this many days (0 = keep everything). Each repository's
# latest completed scan and attested scans are always kept.
SCAN_RETENTION_DAYS=0

# Remote/hosted mode (P1). Required together before binding to a non-loopback HOST:
# ALLOW_REMOTE=true
# API_TOKEN=
# Trusted ingestion of SANITIZED CI summaries (never give this to PR jobs):
# INGEST_TOKEN=

ENABLE_BLOCKCHAIN=false
# P2 only; keep keys in secure storage outside source control:
# SEPOLIA_RPC_URL=
# ATTESTATION_SIGNER_KEY_REFERENCE=env:SS_ATTESTATION_KEY   (or keystore:C:\path\to\keystore.json)
# ATTESTATION_CONTRACT_ADDRESS=
# ATTESTATION_CHAIN_ID=11155111
# TRUSTED_ATTESTATION_SIGNERS=
